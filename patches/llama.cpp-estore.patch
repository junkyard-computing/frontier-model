+++ b/src/llama-estore.h
@@ -0,0 +1,40 @@
+#pragma once
+
+// Flash-streamed MoE experts (frontier-model runtime/estore).
+//
+// Enabled at runtime by FM_ESTORE_PACK=<expert pack> (index at <pack>.idx,
+// or FM_ESTORE_INDEX), with FM_ESTORE_POOL_GB (default 7) and FM_ESTORE_QD
+// (default 16), FM_ESTORE_POLICY (layer, the default, or lru), FM_ESTORE_PREFETCH_QD (prefetch reads in flight, default 2; demand
+// reads never queue behind more), optional FM_ESTORE_PRED (prefetch predictors) and FM_ESTORE_STATS
+// (print cache stats at exit), FM_ESTORE_VK=<vulkan device index> (import the pools into
+// Vulkan through their dma-bufs, so expert matmuls run on the GPU, zero-copy). When enabled, build_moe_ffn routes the expert matmuls
+// through per-group slot pools: a CPU op maps the router's expert ids to
+// pool slots, fetching misses from flash, and the MUL_MAT_IDs read the pools.
+// The model's own *_exps tensors are never touched (keep them mmapped on
+// the CPU, e.g. -ot exps=CPU, so they cost no RAM).
+
+#include "ggml.h"
+
+struct llama_estore;
+
+// the process-wide store, or nullptr when FM_ESTORE_PACK is unset
+llama_estore * llama_estore_get(int n_layer);
+
+// pool tensor standing in for model tensor `exps` (up/gate/down) of layer il. With FM_ESTORE_SPLIT the pools
+// have a CPU view and a Vulkan view of the same memory; gpu selects the Vulkan one
+ggml_tensor * llama_estore_pool(llama_estore * es, int il, const char * proj, const ggml_tensor * exps, bool gpu = false);
+
+// FM_ESTORE_SPLIT=k: run the first k of each token's experts on the GPU and the rest on the CPU, at the
+// same time (0 = off)
+int llama_estore_split_gpu(const llama_estore * es);
+// is (il, expert) resident or loading in the expert cache (no I/O)? For cache-aware routing (FM_CACHE_ROUTE)
+bool llama_estore_resident(llama_estore * es, int il, int expert);
+
+// CPU op: expert ids [n_used, n_tokens] -> slot ids, fetching misses. h is the
+// router input (f32 [n_embd, n_tokens]); at layers with a prefetch predictor
+// (FM_ESTORE_PRED=<train.py --export dir>, at most FM_ESTORE_PRED_M experts per layer
+// with probability > FM_ESTORE_PRED_P; or FM_ESTORE_PRED_INT8=<tools/tpu/make_predictors.py dir>,
+// the int8 TPU predictors run on the CPU with the TPU's arithmetic; add FM_ESTORE_PRED_TPU=1 to run
+// them on the Edge TPU through finch, async unless FM_ESTORE_TPU_SYNC=1)
+// decode steps use it to prefetch the next layers' experts.
+ggml_tensor * llama_estore_residency(llama_estore * es, ggml_context * ctx, ggml_tensor * ids, ggml_tensor * h, int il);
