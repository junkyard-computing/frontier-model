diff --git a/src/llama-estore.cpp b/src/llama-estore.cpp
new file mode 100644
index 000000000..efe9fb95c
--- /dev/null
+++ b/src/llama-estore.cpp
@@ -0,0 +1,643 @@
+#include "llama-estore.h"
+
+#include "llama-impl.h"
+
+#include "ggml-backend.h"
+#include "estore.h"
+
+#ifdef LLAMA_FM_ESTORE_VK
+#include "ggml-vulkan.h"
+#endif
+#ifdef LLAMA_FM_FINCH
+#include "finch.h"
+#endif
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <sched.h>
+#include <condition_variable>
+#include <thread>
+#include <mutex>
+#include <string>
+#include <vector>
+
+struct llama_estore_layer {
+    llama_estore * es;
+    int            il;
+};
+
+// expert-prefetch predictor (tools/predictor/train.py --export): at layer il,
+// logits = W h + b over (layers il+1 .. il+span) x n_expert; prefetch top m
+struct llama_estore_stage {     // one int8 FC of a predictor
+    int din = 0, dout = 0;
+    std::vector<int8_t>  Wq;    // [dout, din]
+    std::vector<int32_t> bq;    // [dout]
+    double w_s = 0;
+};
+
+struct llama_estore_pred {
+    int il = -1;
+    std::vector<float> W, b;    // float form: [span*E, D], [span*E]
+    // int8 form (tools/tpu/make_predictors.py): one FC or a chain, the arithmetic the TPU runs
+    bool int8 = false;
+    std::vector<llama_estore_stage> stages;
+    std::vector<double> acts;   // activation scales: input, (between stages,) output
+    int tpu_id = -1;            // finch executable id when the predictor runs on the TPU
+};
+
+struct llama_estore {
+    estore * st = nullptr;
+    int pred_d = 0, pred_e = 0, pred_span = 0, pred_m = 8;
+    float pred_logit_min = 0.0f;                // prefetch only if sigmoid(logit) > FM_ESTORE_PRED_P
+    std::vector<llama_estore_pred *> pred;      // [n_layer], nullptr where none
+    std::vector<float> pred_logits;
+    std::vector<int8_t> pred_xq, pred_hq, pred_yq;
+#ifdef LLAMA_FM_FINCH
+    finch_ctx * tpu = nullptr;  // FM_ESTORE_PRED_TPU: predictors run on the Edge TPU through finch
+    bool tpu_sync = true;       // dispatch and wait inline (default); FM_ESTORE_TPU_ASYNC=1: the collector thread
+    // async: the collector thread runs the newest request on the TPU and prefetches from it at once
+    std::mutex tpu_mtx;
+    std::condition_variable tpu_cv;
+    int tpu_req_il = -1;        // layer of the pending request, -1 when none
+    std::vector<int8_t> tpu_req_xq;
+    uint64_t tpu_replaced = 0;  // requests overwritten by a newer one before the collector took them
+    uint64_t tpu_dispatch_ns = 0, tpu_lock_wait_ns = 0, tpu_hold_ns = 0;   // collector: finch_dispatch, waiting for mtx, holding it
+#endif
+    int cur_il = -1;            // layer most recently acquired (prefetches for it and earlier are skipped)
+    uint64_t lock_wait_ns = 0;  // residency ops: time spent waiting for mtx
+    uint64_t resid_ns = 0;      // residency ops: total time (lock wait, acquire incl. I/O stall, prediction)
+    ggml_context * ctx = nullptr;               // metadata for the pool tensors
+    ggml_backend_buffer_t buf = nullptr;        // wraps the estore memfd mapping (CPU pools)
+    // FM_ESTORE_VK: [group][proj] Vulkan buffers imported from the pools' dma-bufs (GPU pools)
+    std::vector<std::vector<ggml_backend_buffer_t>> vk_bufs;
+    std::vector<llama_estore_layer> layers;     // custom-op userdata
+    // [group][proj] pool tensors, created on first use
+    std::vector<std::vector<ggml_tensor *>> pools;
+    std::vector<std::vector<ggml_tensor *>> pools_gpu;   // FM_ESTORE_SPLIT: the Vulkan views of the same pools
+    int split_gpu = 0;                          // FM_ESTORE_SPLIT: experts per token computed on the GPU
+    std::vector<int> scratch_experts, scratch_slots, expert_slot;
+    std::vector<uint8_t> seen;
+    std::mutex mtx;
+};
+
+static ggml_type type_from_name(const char * name) {
+    for (int t = 0; t < GGML_TYPE_COUNT; ++t) {
+        const char * n = ggml_type_name((ggml_type) t);
+        if (n && strcasecmp(n, name) == 0) {
+            return (ggml_type) t;
+        }
+    }
+    return GGML_TYPE_COUNT;
+}
+
+static uint64_t estore_now_ns() {
+    return (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static void estore_print_stats() {
+    llama_estore * es = llama_estore_get(0);
+    if (!es) {
+        return;
+    }
+    estore_stats s;
+    estore_get_stats(es->st, &s);
+    const double acc = (double) (s.hits + s.inflight_hits + s.misses);
+    fprintf(stderr, "estore: %.0f expert accesses: hit %.4f, inflight hit %.4f, miss %.4f; %lu prefetches (%.3f used); "
+                    "%.3f GB read; %.3f s stalled, %.3f s submitting reads; %lu stale prefetches dropped\n",
+            acc, s.hits / acc, s.inflight_hits / acc, s.misses / acc, (unsigned long) s.prefetches,
+            s.prefetches ? (double) s.prefetch_used / s.prefetches : 0.0, s.bytes_read / 1e9, s.stall_ns / 1e9, s.submit_ns / 1e9, (unsigned long) s.prefetch_dropped);
+    fprintf(stderr, "estore: residency ops took %.3f s in all, %.3f s of it waiting for the store lock\n", es->resid_ns / 1e9, es->lock_wait_ns / 1e9);
+#ifdef LLAMA_FM_FINCH
+    if (es->tpu && !es->tpu_sync) {
+        fprintf(stderr, "estore: TPU collector: %lu predictions replaced by a newer one before they ran; %.3f s in finch_dispatch, %.3f s waiting for and %.3f s holding the store lock\n",
+                (unsigned long) es->tpu_replaced, es->tpu_dispatch_ns / 1e9, es->tpu_lock_wait_ns / 1e9, es->tpu_hold_ns / 1e9);
+    }
+#endif
+}
+
+#ifdef LLAMA_FM_FINCH
+// Register the TPU predictor executables before the expert pools exist: the mainline TPU driver
+// backs each buffer with physically contiguous pages, which are hard to find once GBs of pool memory
+// are allocated (registration then fails with ENOMEM).
+// pin the calling thread to FM_FINCH_CPUS (default the little cores, "0-3")
+static void estore_pin_finch_cpus(const char * what) {
+    const char * spec = getenv("FM_FINCH_CPUS") ? getenv("FM_FINCH_CPUS") : "0-3";
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    int a = -1, b = -1;
+    if (sscanf(spec, "%d-%d", &a, &b) == 2) {
+        for (int c = a; c <= b; ++c) CPU_SET(c, &set);
+    } else if (sscanf(spec, "%d", &a) == 1) {
+        CPU_SET(a, &set);
+    }
+    if (CPU_COUNT(&set) > 0 && sched_setaffinity(0, sizeof(set), &set) != 0) {
+        LLAMA_LOG_WARN("%s: cannot pin the %s to CPUs %s\n", __func__, what, spec);
+    }
+}
+
+static void estore_tpu_collector(llama_estore * es);
+
+static finch_ctx * estore_tpu_preregister(const std::string & d, std::map<int, uint32_t> & ids) {
+    // finch_open starts finch's worker thread, and a new thread inherits its creator's CPU mask: open
+    // from a helper pinned to FM_FINCH_CPUS (default the little cores, "0-3") so the worker never takes
+    // time from the decode threads
+    finch_ctx * tpu = nullptr;
+    int rc = FINCH_ERR;
+    std::string err;
+    std::thread opener([&]() {
+        estore_pin_finch_cpus("finch worker");
+        rc = finch_open(nullptr, &tpu);
+        if (rc != FINCH_OK) err = finch_last_error(nullptr);
+    });
+    opener.join();
+    if (rc != FINCH_OK) {
+        GGML_ABORT("FM_ESTORE_PRED_TPU: finch_open: %s", err.c_str());
+    }
+    LLAMA_LOG_INFO("%s: finch worker on CPUs %s\n", __func__, getenv("FM_FINCH_CPUS") ? getenv("FM_FINCH_CPUS") : "0-3");
+    FILE * f = fopen((d + "/manifest.txt").c_str(), "r");
+    int span = 0, il, ns;
+    if (!f || fscanf(f, " span %d", &span) != 1) GGML_ABORT("FM_ESTORE_PRED_TPU: bad %s/manifest.txt", d.c_str());
+    while (fscanf(f, "%d %d", &il, &ns) == 2 && ns >= 1 && ns <= 4) {
+        std::vector<double> v(2 * ns + 2 + ns);            // dims (ns+1), act scales (ns+1), weight scales (ns)
+        for (auto & x : v) if (fscanf(f, "%lf", &x) != 1) GGML_ABORT("bad manifest row for layer %d", il);
+        const size_t in_sz = (size_t) v[0], out_sz = (size_t) v[ns];
+        const std::string bin = d + "/pred_" + std::to_string(il) + ".bin";
+        FILE * bf = fopen(bin.c_str(), "rb");
+        if (!bf) GGML_ABORT("FM_ESTORE_PRED_TPU: missing %s", bin.c_str());
+        std::vector<char> exe;
+        char buf[1 << 16];
+        size_t n;
+        while ((n = fread(buf, 1, sizeof(buf), bf)) > 0) exe.insert(exe.end(), buf, buf + n);
+        fclose(bf);
+        uint32_t id;
+        if (finch_register(tpu, exe.data(), exe.size(), &in_sz, 1, &out_sz, 1, &id) != FINCH_OK) {
+            GGML_ABORT("FM_ESTORE_PRED_TPU: register layer %d: %s", il, finch_last_error(tpu));
+        }
+        ids[il] = id;
+    }
+    fclose(f);
+    return tpu;
+}
+#endif
+
+llama_estore * llama_estore_get(int n_layer) {
+    static std::once_flag once;
+    static llama_estore * inst = nullptr;
+    std::call_once(once, [&]() {
+        const char * pack = getenv("FM_ESTORE_PACK");
+        if (!pack || !*pack) {
+            return;
+        }
+        std::string index = getenv("FM_ESTORE_INDEX") ? getenv("FM_ESTORE_INDEX") : std::string(pack) + ".idx";
+        const double pool_gb = getenv("FM_ESTORE_POOL_GB") ? atof(getenv("FM_ESTORE_POOL_GB")) : 7.0;
+        estore_cfg cfg = {};
+        cfg.pack       = pack;
+        cfg.index      = index.c_str();
+        cfg.pool_bytes = (uint64_t) (pool_gb * 1e9);
+        cfg.qd         = getenv("FM_ESTORE_QD") ? atoi(getenv("FM_ESTORE_QD")) : 16;
+        cfg.hugetlb    = getenv("FM_ESTORE_HUGETLB") ? 1 : 0;
+        cfg.prefetch_qd = getenv("FM_ESTORE_PREFETCH_QD") ? atoi(getenv("FM_ESTORE_PREFETCH_QD")) : 2;
+        // the G710 does not snoop the CPU caches that coherent UFS DMA writes land in: when it reads the
+        // pools (FM_ESTORE_VK), every landed slot must be cleaned to DRAM
+        cfg.clean_slots = (getenv("FM_ESTORE_CLEAN") || getenv("FM_ESTORE_VK") || getenv("FM_ESTORE_SPLIT")) ? 1 : 0;
+        cfg.prefetch_buffer = getenv("FM_ESTORE_PF_BUFFER") ? atoi(getenv("FM_ESTORE_PF_BUFFER")) : 0;
+        // on by default (=0 turns them off): with UFS's shallow block queue a blocking submit stalls
+        // whichever thread issues the read, and queued prefetch requests delay demand reads
+        cfg.async_submit   = !getenv("FM_ESTORE_ASYNC_SUBMIT") || atoi(getenv("FM_ESTORE_ASYNC_SUBMIT")) != 0;
+        cfg.pf_ioprio_idle = !getenv("FM_ESTORE_PF_IDLE") || atoi(getenv("FM_ESTORE_PF_IDLE")) != 0;
+        static int * layer_weights = nullptr;   // FM_ESTORE_SHARES: per-layer shares (tools/sim/policy_lab.py alloc --save)
+        if (const char * sp = getenv("FM_ESTORE_SHARES")) {
+            cfg.n_layer_weights = estore_read_layer_weights(sp, &layer_weights);
+            if (cfg.n_layer_weights < 0) GGML_ABORT("FM_ESTORE_SHARES: cannot read %s", sp);
+            cfg.layer_weights = layer_weights;
+            LLAMA_LOG_INFO("%s: per-layer expert shares from %s\n", __func__, sp);
+        }
+        cfg.policy = getenv("FM_ESTORE_POLICY") && !strcmp(getenv("FM_ESTORE_POLICY"), "lru") ? ESTORE_POLICY_LRU : ESTORE_POLICY_LAYER;
+#ifdef LLAMA_FM_FINCH
+        std::map<int, uint32_t> tpu_ids;
+        finch_ctx * tpu = nullptr;
+        if (getenv("FM_ESTORE_PRED_TPU") && getenv("FM_ESTORE_PRED_INT8")) {
+            tpu = estore_tpu_preregister(getenv("FM_ESTORE_PRED_INT8"), tpu_ids);
+        }
+#endif
+        estore * st = estore_open(&cfg);
+        if (!st) {
+            GGML_ABORT("FM_ESTORE_PACK=%s: estore_open failed", pack);
+        }
+        if (estore_n_layer(st) != n_layer) {
+            GGML_ABORT("expert pack has %d layers, model has %d", estore_n_layer(st), n_layer);
+        }
+        auto * es = new llama_estore();
+        es->st = st;
+
+        // one CPU buffer over the whole pool mapping; tensors are placed at their pool offsets
+        const int ng = estore_n_groups(st);
+        size_t total = 0;
+        for (int g = 0; g < ng; ++g) {
+            for (int p = 0; p < estore_n_proj(st, g); ++p) {
+                total = std::max<size_t>(total, estore_pool_offset(st, g, p) +
+                                         (size_t) estore_n_slots(st, g) * estore_proj_size(st, g, p));
+            }
+        }
+        es->buf = ggml_backend_cpu_buffer_from_ptr(estore_pool(st, 0, 0), total);
+        // the pools are the expert weights: flag them so the scheduler runs their ops where they live
+        // instead of copying GBs of "inputs" to another backend
+        ggml_backend_buffer_set_usage(es->buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        const char * vk = getenv("FM_ESTORE_VK");
+        if (!vk && getenv("FM_ESTORE_SPLIT")) vk = "0";   // the split needs the Vulkan views too
+        if (vk) {
+#ifdef LLAMA_FM_ESTORE_VK
+            // zero-copy: the GPU reads the same pages io_uring fills
+            if (!estore_dmabuf_ok(st)) {
+                GGML_ABORT("FM_ESTORE_VK: the pools have no dma-bufs (is /dev/udmabuf usable?)");
+            }
+            const int dev = atoi(vk);
+            es->vk_bufs.assign(ng, std::vector<ggml_backend_buffer_t>(ESTORE_MAX_PROJ, nullptr));
+            for (int g = 0; g < ng; ++g) {
+                for (int p = 0; p < estore_n_proj(st, g); ++p) {
+                    es->vk_bufs[g][p] = ggml_backend_vk_buffer_from_dmabuf(dev, estore_pool_dmabuf_fd(st, g, p), estore_pool_bytes(st, g, p));
+                    if (!es->vk_bufs[g][p]) {
+                        GGML_ABORT("FM_ESTORE_VK: Vulkan device %d cannot import pool g%d.%s", dev, g, estore_proj_name(st, g, p));
+                    }
+                    ggml_backend_buffer_set_usage(es->vk_bufs[g][p], GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+                }
+            }
+            LLAMA_LOG_INFO("%s: expert pools imported into Vulkan device %d (dma-buf, zero-copy)\n", __func__, dev);
+#else
+            GGML_UNUSED(vk);
+            GGML_ABORT("FM_ESTORE_VK: llama was built without the Vulkan backend");
+#endif
+        }
+        ggml_init_params ip = { ggml_tensor_overhead() * ESTORE_MAX_GROUPS * ESTORE_MAX_PROJ * 2, nullptr, true };
+        es->ctx = ggml_init(ip);
+        es->pools.assign(ng, std::vector<ggml_tensor *>(ESTORE_MAX_PROJ, nullptr));
+        es->pools_gpu.assign(ng, std::vector<ggml_tensor *>(ESTORE_MAX_PROJ, nullptr));
+        if (const char * sp = getenv("FM_ESTORE_SPLIT")) {
+            es->split_gpu = atoi(sp);
+            LLAMA_LOG_INFO("%s: split experts: %d per token on the GPU, the rest on the CPU\n", __func__, es->split_gpu);
+        }
+        es->layers.resize(n_layer);
+        int max_expert = 0;
+        for (int il = 0; il < n_layer; ++il) {
+            es->layers[il] = { es, il };
+            max_expert = std::max(max_expert, estore_n_expert(st, il));
+        }
+        es->expert_slot.resize(max_expert);
+        es->seen.resize(max_expert);
+        es->pred.assign(n_layer, nullptr);
+        if (const char * dir = getenv("FM_ESTORE_PRED_INT8")) {
+            // int8 predictors as packaged for the TPU: manifest.txt + pred_<l>.s<k>.w.i8 / .b.i32 (+ pred_<l>.bin)
+            std::string d = dir;
+            FILE * f = fopen((d + "/manifest.txt").c_str(), "r");
+            if (!f || fscanf(f, " span %d", &es->pred_span) != 1 || es->pred_span <= 0) {
+                GGML_ABORT("FM_ESTORE_PRED_INT8=%s: bad manifest.txt", dir);
+            }
+            int n_pl = 0, il, ns;
+            while (fscanf(f, "%d %d", &il, &ns) == 2) {
+                if (il < 0 || il >= n_layer || ns < 1 || ns > 4) GGML_ABORT("bad manifest.txt row for layer %d", il);
+                auto * pr = new llama_estore_pred();
+                pr->il = il;
+                pr->int8 = true;
+                std::vector<int> dims(ns + 1);
+                pr->acts.resize(ns + 1);
+                pr->stages.resize(ns);
+                bool ok = true;
+                for (int k = 0; k <= ns; ++k) ok &= fscanf(f, "%d", &dims[k]) == 1;
+                for (int k = 0; k <= ns; ++k) ok &= fscanf(f, "%lf", &pr->acts[k]) == 1;
+                for (int k = 0; k < ns; ++k) ok &= fscanf(f, "%lf", &pr->stages[k].w_s) == 1;
+                if (!ok || dims[ns] % es->pred_span) GGML_ABORT("bad manifest.txt row for layer %d", il);
+                for (int k = 0; k < ns; ++k) {
+                    auto & st = pr->stages[k];
+                    st.din = dims[k];
+                    st.dout = dims[k + 1];
+                    st.Wq.resize((size_t) st.dout * st.din);
+                    st.bq.resize(st.dout);
+                    const std::string base = d + "/pred_" + std::to_string(il) + ".s" + std::to_string(k);
+                    FILE * w = fopen((base + ".w.i8").c_str(), "rb");
+                    FILE * bf = fopen((base + ".b.i32").c_str(), "rb");
+                    if (!w || !bf || fread(st.Wq.data(), 1, st.Wq.size(), w) != st.Wq.size() ||
+                        fread(st.bq.data(), sizeof(int32_t), st.bq.size(), bf) != st.bq.size()) {
+                        GGML_ABORT("FM_ESTORE_PRED_INT8=%s: cannot read stage %d of layer %d", dir, k, il);
+                    }
+                    fclose(w);
+                    fclose(bf);
+                }
+                es->pred_d = dims[0];
+                es->pred_e = dims[ns] / es->pred_span;
+                es->pred[il] = pr;
+                n_pl++;
+            }
+            fclose(f);
+            es->pred_m = getenv("FM_ESTORE_PRED_M") ? atoi(getenv("FM_ESTORE_PRED_M")) : 8;
+            const float p_min = getenv("FM_ESTORE_PRED_P") ? atof(getenv("FM_ESTORE_PRED_P")) : 0.5f;
+            es->pred_logit_min = logf(p_min / (1.0f - p_min));
+            const size_t n_out = (size_t) es->pred_span * es->pred_e;
+            es->pred_logits.resize(n_out);
+            es->pred_xq.resize(es->pred_d);
+            es->pred_hq.resize(2 * 4096);
+            es->pred_yq.resize(n_out);
+            const char * where = "CPU, TPU arithmetic";
+            if (getenv("FM_ESTORE_PRED_TPU")) {
+#ifdef LLAMA_FM_FINCH
+                es->tpu = tpu;    // opened and registered before the pools were allocated
+                // sync (dispatch and wait inline) is the default: on the Fold it is 1-2% faster than the
+                // collector thread for both 30B and 235B; FM_ESTORE_TPU_ASYNC=1 selects the collector
+                es->tpu_sync = !getenv("FM_ESTORE_TPU_ASYNC") || atoi(getenv("FM_ESTORE_TPU_ASYNC")) == 0;
+                for (auto * pr : es->pred) {
+                    if (!pr) continue;
+                    auto it = tpu_ids.find(pr->il);
+                    if (it == tpu_ids.end()) GGML_ABORT("FM_ESTORE_PRED_TPU: no executable for layer %d", pr->il);
+                    pr->tpu_id = (int) it->second;
+                }
+                if (!es->tpu_sync) std::thread(estore_tpu_collector, es).detach();
+                where = es->tpu_sync ? "Edge TPU, sync" : "Edge TPU, async";
+#else
+                GGML_ABORT("FM_ESTORE_PRED_TPU: llama was built without finch (LLAMA_FM_FINCH_DIR)");
+#endif
+            }
+            LLAMA_LOG_INFO("%s: %d int8 prefetch predictors (%s; span %d, top %d, p > %.2f) from %s\n", __func__, n_pl,
+                           where, es->pred_span, es->pred_m, p_min, dir);
+        } else if (const char * dir = getenv("FM_ESTORE_PRED")) {
+            std::string d = dir;
+            FILE * f = fopen((d + "/pred.txt").c_str(), "r");
+            int n_pl = 0, ver = 0;
+            if (!f || fscanf(f, "fmpred %d %d %d %d %d", &ver, &es->pred_d, &es->pred_e, &es->pred_span, &n_pl) != 5 || ver != 1) {
+                GGML_ABORT("FM_ESTORE_PRED=%s: bad pred.txt", dir);
+            }
+            const size_t n_out = (size_t) es->pred_span * es->pred_e;
+            for (int i = 0; i < n_pl; ++i) {
+                int il;
+                if (fscanf(f, "%d", &il) != 1 || il < 0 || il >= n_layer) GGML_ABORT("bad pred.txt layer list");
+                auto * pr = new llama_estore_pred();
+                pr->il = il;
+                pr->W.resize(n_out * es->pred_d);
+                pr->b.resize(n_out);
+                FILE * w = fopen((d + "/pred_" + std::to_string(il) + ".f32").c_str(), "rb");
+                if (!w || fread(pr->W.data(), sizeof(float), pr->W.size(), w) != pr->W.size() ||
+                    fread(pr->b.data(), sizeof(float), pr->b.size(), w) != pr->b.size()) {
+                    GGML_ABORT("FM_ESTORE_PRED=%s: cannot read predictor for layer %d", dir, il);
+                }
+                fclose(w);
+                es->pred[il] = pr;
+            }
+            fclose(f);
+            es->pred_m = getenv("FM_ESTORE_PRED_M") ? atoi(getenv("FM_ESTORE_PRED_M")) : 8;
+            const float p_min = getenv("FM_ESTORE_PRED_P") ? atof(getenv("FM_ESTORE_PRED_P")) : 0.5f;
+            es->pred_logit_min = logf(p_min / (1.0f - p_min));
+            es->pred_logits.resize(n_out);
+            LLAMA_LOG_INFO("%s: %d prefetch predictors (span %d, top %d, p > %.2f) from %s\n", __func__, n_pl, es->pred_span, es->pred_m, p_min, dir);
+        }
+        LLAMA_LOG_INFO("%s: streaming experts from %s: %d layer groups, %.2f GB pool, dma-bufs %s\n",
+                       __func__, pack, ng, pool_gb, estore_dmabuf_ok(st) ? "yes" : "no");
+        inst = es;
+        if (getenv("FM_ESTORE_STATS")) {
+            atexit(estore_print_stats);
+        }
+    });
+    return inst;
+}
+
+int llama_estore_split_gpu(const llama_estore * es) {
+    return es ? es->split_gpu : 0;
+}
+
+bool llama_estore_resident(llama_estore * es, int il, int expert) {
+    std::lock_guard<std::mutex> lock(es->mtx);
+    return estore_resident(es->st, il, expert) > 0;
+}
+
+ggml_tensor * llama_estore_pool(llama_estore * es, int il, const char * proj, const ggml_tensor * exps, bool gpu) {
+    std::lock_guard<std::mutex> lock(es->mtx);
+    estore * st = es->st;
+    const int g = estore_layer_group(st, il);
+    int p = 0;
+    while (p < estore_n_proj(st, g) && strcmp(estore_proj_name(st, g, p), proj) != 0) {
+        p++;
+    }
+    GGML_ASSERT(p < estore_n_proj(st, g) && "projection missing from the expert pack");
+    // split mode keeps both views: the CPU view by default, the Vulkan view for gpu; otherwise the one view
+    // is Vulkan when FM_ESTORE_VK imported the pools
+    const bool split = es->split_gpu > 0;
+    const bool want_vk = split ? gpu : !es->vk_bufs.empty();
+    GGML_ASSERT((!gpu || split) && "estore: a GPU pool view needs FM_ESTORE_SPLIT");
+    ggml_tensor *& t = (split && gpu) ? es->pools_gpu[g][p] : es->pools[g][p];
+    const ggml_type type = type_from_name(estore_proj_type(st, g, p));
+    if (type != exps->type || ggml_row_size(type, exps->ne[0]) * exps->ne[1] != estore_proj_size(st, g, p)) {
+        GGML_ABORT("layer %d %s: pack has %s/%lu B per expert, model has %s/%zu B",
+                   il, proj, estore_proj_type(st, g, p), (unsigned long) estore_proj_size(st, g, p),
+                   ggml_type_name(exps->type), ggml_row_size(exps->type, exps->ne[0]) * exps->ne[1]);
+    }
+    if (!t) {
+        t = ggml_new_tensor_3d(es->ctx, type, exps->ne[0], exps->ne[1], estore_n_slots(st, g));
+        ggml_format_name(t, want_vk && split ? "estore_pool_gpu.g%d.%s" : "estore_pool.g%d.%s", g, proj);
+        ggml_backend_buffer_t buf = es->buf;
+        void * base = (char *) estore_pool(st, 0, 0) + estore_pool_offset(st, g, p);
+        GGML_ASSERT(((uintptr_t) base % 64) == 0);
+        if (want_vk) {
+            buf  = es->vk_bufs[g][p];
+            base = ggml_backend_buffer_get_base(buf);   // slot 0 is at offset 0 of the pool's dma-buf
+        }
+        if (ggml_backend_tensor_alloc(buf, t, base) != GGML_STATUS_SUCCESS) {
+            GGML_ABORT("estore: cannot place pool tensor");
+        }
+    }
+    GGML_ASSERT(t->ne[0] == exps->ne[0] && t->ne[1] == exps->ne[1]);
+    return t;
+}
+
+// prefetch the top experts of layers pr->il+1 .. +span whose logits are in es->pred_logits,
+// skipping layers at or before `cur` (already acquired)
+static void estore_issue_prefetch(llama_estore * es, int il, int cur) {
+    const int E = es->pred_e;
+    std::vector<int> order(E);
+    for (int s = 0; s < es->pred_span; ++s) {
+        const int lp = il + 1 + s;
+        if (lp >= (int) es->layers.size()) break;
+        if (lp <= cur) continue;
+        const float * ls = es->pred_logits.data() + (size_t) s * E;
+        for (int e = 0; e < E; ++e) order[e] = e;
+        const int m = std::min(es->pred_m, E);
+        std::partial_sort(order.begin(), order.begin() + m, order.end(), [&](int a, int b) { return ls[a] > ls[b]; });
+        for (int k = 0; k < m && ls[order[k]] > es->pred_logit_min; ++k) {
+            estore_prefetch(es->st, lp, order[k]);
+        }
+    }
+}
+
+static int8_t q8(double v) { return (int8_t) std::min(127.0, std::max(-128.0, std::nearbyint(v))); }
+
+// symmetric int8 FC chain as TFLite/finch run it (tools/predictor/train.py int8_fc): int32 accumulate,
+// requantize to the next activation scale, clamp; writes the final int8 outputs to yq
+static void estore_int8_chain(llama_estore * es, const llama_estore_pred * pr, const int8_t * xq, int8_t * yq) {
+    const int8_t * in = xq;
+    for (size_t k = 0; k < pr->stages.size(); ++k) {
+        const auto & st = pr->stages[k];
+        // stage outputs alternate between two intermediate buffers so no stage reads what it writes
+        int8_t * out = k + 1 == pr->stages.size() ? yq : es->pred_hq.data() + (k % 2) * 4096;
+        GGML_ASSERT(k + 1 == pr->stages.size() || st.dout <= 4096);
+        const double mult = pr->acts[k] * st.w_s / pr->acts[k + 1];
+        for (int o = 0; o < st.dout; ++o) {
+            const int8_t * w = &st.Wq[(size_t) o * st.din];
+            int32_t acc = st.bq[o];
+            for (int i = 0; i < st.din; ++i) acc += (int32_t) w[i] * in[i];
+            out[o] = q8(acc * mult);
+        }
+        in = out;
+    }
+}
+
+static void estore_int8_logits(llama_estore * es, const llama_estore_pred * pr, const int8_t * yq) {
+    const double out_s = pr->acts.back();
+    for (size_t o = 0; o < es->pred_logits.size(); ++o) es->pred_logits[o] = (float) (yq[o] * out_s);
+}
+
+#ifdef LLAMA_FM_FINCH
+// async TPU predictions: the only thread that calls finch after registration. Takes the newest request,
+// runs it, and issues its prefetches as soon as the TPU returns, while the decode threads compute the
+// layer; only layers acquired in the meantime are skipped. (Collecting at the next residency op instead
+// loses the first of the span's layers and a layer of lead time for the rest.)
+static void estore_tpu_collector(llama_estore * es) {
+    estore_pin_finch_cpus("TPU collector");
+    std::vector<int8_t> xq, yq(es->pred_yq.size());
+    for (;;) {
+        int il;
+        {
+            std::unique_lock<std::mutex> lk(es->tpu_mtx);
+            es->tpu_cv.wait(lk, [es] { return es->tpu_req_il >= 0; });
+            il = es->tpu_req_il;
+            es->tpu_req_il = -1;
+            xq.swap(es->tpu_req_xq);
+        }
+        const llama_estore_pred * pr = es->pred[il];
+        const void * ins[1] = { xq.data() };
+        void * outs[1] = { yq.data() };
+        const uint64_t t0 = estore_now_ns();
+        if (finch_dispatch(es->tpu, (uint32_t) pr->tpu_id, ins, outs) != FINCH_OK) {
+            GGML_ABORT("finch_dispatch (layer %d): %s", il, finch_last_error(es->tpu));
+        }
+        const uint64_t t_d = estore_now_ns();
+        std::lock_guard<std::mutex> lock(es->mtx);
+        const uint64_t t1 = estore_now_ns();
+        estore_int8_logits(es, pr, yq.data());
+        estore_issue_prefetch(es, il, es->cur_il);
+        es->tpu_dispatch_ns += t_d - t0;
+        es->tpu_lock_wait_ns += t1 - t_d;
+        es->tpu_hold_ns += estore_now_ns() - t1;
+    }
+}
+#endif
+
+// run the predictor of layer il on router input x (f32 [pred_d]) and issue prefetches
+static void estore_predict(llama_estore * es, const llama_estore_pred * pr, const float * x, int il) {
+    const int D = es->pred_d;
+    if (!pr->int8) {
+        float * lg = es->pred_logits.data();
+        for (size_t o = 0; o < es->pred_logits.size(); ++o) {
+            const float * w = &pr->W[o * D];
+            float acc = pr->b[o];
+            for (int i = 0; i < D; ++i) acc += w[i] * x[i];
+            lg[o] = acc;
+        }
+        estore_issue_prefetch(es, il, il);
+        return;
+    }
+    int8_t * xq = es->pred_xq.data();
+    for (int i = 0; i < D; ++i) xq[i] = q8(x[i] / pr->acts[0]);
+#ifdef LLAMA_FM_FINCH
+    if (es->tpu) {
+        const void * ins[1] = { xq };
+        if (es->tpu_sync) {
+            void * outs[1] = { es->pred_yq.data() };
+            if (finch_dispatch(es->tpu, (uint32_t) pr->tpu_id, ins, outs) != FINCH_OK) {
+                GGML_ABORT("finch_dispatch: %s", finch_last_error(es->tpu));
+            }
+            estore_int8_logits(es, pr, es->pred_yq.data());
+            estore_issue_prefetch(es, il, il);
+        } else {
+            // hand off to the collector; a request it hasn't taken yet is stale, so replace it
+            {
+                std::lock_guard<std::mutex> lk(es->tpu_mtx);
+                es->tpu_replaced += es->tpu_req_il >= 0;
+                es->tpu_req_il = il;
+                es->tpu_req_xq.assign(xq, xq + D);
+            }
+            es->tpu_cv.notify_one();
+        }
+        return;
+    }
+#endif
+    estore_int8_chain(es, pr, xq, es->pred_yq.data());
+    estore_int8_logits(es, pr, es->pred_yq.data());
+    estore_issue_prefetch(es, il, il);
+}
+
+// dst = slot of src[0] (ids), per element; runs on one thread
+static void estore_residency_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+    auto * lu = (llama_estore_layer *) userdata;
+    llama_estore * es = lu->es;
+    const ggml_tensor * ids = dst->src[0];
+    const int64_t n_used = ids->ne[0];
+    const int64_t n_tok  = ids->ne[1];
+
+    const uint64_t t_lock = estore_now_ns();
+    std::lock_guard<std::mutex> lock(es->mtx);
+    es->lock_wait_ns += estore_now_ns() - t_lock;
+    es->cur_il = lu->il;   // being acquired now: the demand path takes it, prefetching it is too late
+    std::fill(es->seen.begin(), es->seen.end(), 0);
+    es->scratch_experts.clear();
+    for (int64_t t = 0; t < n_tok; ++t) {
+        const int32_t * row = (const int32_t *) ((const char *) ids->data + t * ids->nb[1]);
+        for (int64_t k = 0; k < n_used; ++k) {
+            if (!es->seen[row[k]]) {
+                es->seen[row[k]] = 1;
+                es->scratch_experts.push_back(row[k]);
+            }
+        }
+    }
+    // GPU batch: the pools are read on the GPU this time (FM_ESTORE_VK always; FM_ESTORE_SPLIT only for batches the
+    // graph splits, n_tokens >= FM_ESTORE_SPLIT_MIN_TOKENS, default 32, as in llama-graph.cpp)
+    static const int64_t split_min = getenv("FM_ESTORE_SPLIT_MIN_TOKENS") ? atoll(getenv("FM_ESTORE_SPLIT_MIN_TOKENS")) : 32;
+    estore_set_gpu_batch(es->st, getenv("FM_ESTORE_VK") != nullptr || (es->split_gpu > 0 && n_tok >= split_min));
+    es->scratch_slots.resize(es->scratch_experts.size());
+    if (estore_acquire(es->st, lu->il, (int) es->scratch_experts.size(),
+                       es->scratch_experts.data(), es->scratch_slots.data()) != 0) {
+        GGML_ABORT("estore_acquire failed (layer %d, %zu experts)", lu->il, es->scratch_experts.size());
+    }
+    for (size_t i = 0; i < es->scratch_experts.size(); ++i) {
+        es->expert_slot[es->scratch_experts[i]] = es->scratch_slots[i];
+    }
+    for (int64_t t = 0; t < n_tok; ++t) {
+        const int32_t * row = (const int32_t *) ((const char *) ids->data + t * ids->nb[1]);
+        int32_t * out = (int32_t *) ((char *) dst->data + t * dst->nb[1]);
+        for (int64_t k = 0; k < n_used; ++k) {
+            out[k] = es->expert_slot[row[k]];
+        }
+    }
+
+    // decode: predict the next layers' experts from this layer's router input and
+    // start their reads; they overlap with this layer's compute. (Prefill needs
+    // no prediction: its per-layer union of experts already keeps the queue deep.)
+    const llama_estore_pred * pr = es->pred[lu->il];
+    const ggml_tensor * h = dst->src[1];
+    if (pr && h && n_tok == 1) {
+        GGML_ASSERT(h->type == GGML_TYPE_F32 && h->ne[0] == es->pred_d);
+        estore_predict(es, pr, (const float *) h->data, lu->il);
+    }
+    es->resid_ns += estore_now_ns() - t_lock;
+}
+
+ggml_tensor * llama_estore_residency(llama_estore * es, ggml_context * ctx, ggml_tensor * ids, ggml_tensor * h, int il) {
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    ggml_tensor * args[2] = { ids, h };
+    const int n_args = es->pred[il] ? 2 : 1;   // the router input is only needed at predictor layers
+    return ggml_custom_4d(ctx, GGML_TYPE_I32, ids->ne[0], ids->ne[1], 1, 1, args, n_args,
+                          estore_residency_op, 1, &es->layers[il]);
+}
