+// Import a dma-buf (e.g. a udmabuf over a memfd) as a storage buffer. The memory stays shared with
+// whoever else maps the dma-buf (CPU, other devices); nothing is copied. fd stays owned by the caller.
+vk_buffer ggml_vk_buffer_from_dmabuf(vk_device & device, int fd, size_t size) {
+    if (!device->external_memory_dma_buf || size == 0 || size > device->max_buffer_size) {
+        return {};
+    }
+    const auto handle_type = vk::ExternalMemoryHandleTypeFlagBits::eDmaBufEXT;
+
+    vk::BufferUsageFlags usage_flags = vk::BufferUsageFlagBits::eStorageBuffer | vk::BufferUsageFlagBits::eTransferSrc | vk::BufferUsageFlagBits::eTransferDst;
+    vk::MemoryAllocateFlags mem_flags {};
+    if (device->buffer_device_address) {
+        usage_flags |= vk::BufferUsageFlagBits::eShaderDeviceAddress;
+        mem_flags |= vk::MemoryAllocateFlagBits::eDeviceAddress;
+    }
+    vk::ExternalMemoryBufferCreateInfo external_memory_bci { handle_type };
+    vk::BufferCreateInfo buffer_create_info { vk::BufferCreateFlags(), size, usage_flags, vk::SharingMode::eExclusive, 0, nullptr, &external_memory_bci };
+
+    vk_buffer buf = std::make_shared<vk_buffer_struct>();
+    buf->buffer = device->device.createBuffer(buffer_create_info);
+    const vk::MemoryRequirements mem_req = device->device.getBufferMemoryRequirements(buf->buffer);
+
+    vk::MemoryFdPropertiesKHR fd_props;
+    try {
+        fd_props = device->device.getMemoryFdPropertiesKHR(handle_type, fd);
+    } catch (vk::SystemError & e) {
+        GGML_LOG_WARN("ggml_vulkan: getMemoryFdPropertiesKHR failed (%s)\n", e.what());
+        device->device.destroyBuffer(buf->buffer);
+        return {};
+    }
+    if (mem_req.size > size) {
+        GGML_LOG_WARN("ggml_vulkan: dma-buf of %zu bytes too small for buffer (needs %zu)\n", size, (size_t) mem_req.size);
+        device->device.destroyBuffer(buf->buffer);
+        return {};
+    }
+
+    // prefer a host-visible type so the buffer can also be mapped
+    const vk::PhysicalDeviceMemoryProperties mem_props = device->physical_device.getMemoryProperties();
+    const uint32_t allowed = fd_props.memoryTypeBits & mem_req.memoryTypeBits;
+    uint32_t idx = 32;
+    for (uint32_t i = 0; i < mem_props.memoryTypeCount; ++i) {
+        if (!(allowed & (1u << i))) {
+            continue;
+        }
+        if (idx == 32 || (mem_props.memoryTypes[i].propertyFlags & vk::MemoryPropertyFlagBits::eHostVisible)) {
+            idx = i;
+        }
+        if (mem_props.memoryTypes[i].propertyFlags & vk::MemoryPropertyFlagBits::eHostVisible) {
+            break;
+        }
+    }
+    if (idx == 32) {
+        GGML_LOG_WARN("ggml_vulkan: no memory type can import this dma-buf\n");
+        device->device.destroyBuffer(buf->buffer);
+        return {};
+    }
+
+    // on success the driver owns the fd it was given, so hand it a duplicate
+    const int import_fd = dup(fd);
+    vk::MemoryAllocateFlagsInfo mem_flags_info { mem_flags };
+    vk::ImportMemoryFdInfoKHR import_info { handle_type, import_fd, &mem_flags_info };
+    try {
+        buf->device_memory = device->device.allocateMemory({ mem_req.size, idx, &import_info });
+    } catch (const vk::SystemError & e) {
+        GGML_LOG_WARN("ggml_vulkan: dma-buf import failed (%s)\n", e.what());
+        close(import_fd);
+        device->device.destroyBuffer(buf->buffer);
+        return {};
+    }
+    buf->memory_property_flags = mem_props.memoryTypes[idx].propertyFlags;
+    buf->ptr = nullptr;
+    if (buf->memory_property_flags & vk::MemoryPropertyFlagBits::eHostVisible) {
+        // some drivers refuse to map imported dma-bufs; then treat the buffer as device-only
+        // (the exporter already has its own CPU mapping of these pages)
+        try {
+            buf->ptr = device->device.mapMemory(buf->device_memory, 0, VK_WHOLE_SIZE);
+        } catch (const vk::SystemError &) {
+            buf->memory_property_flags &= ~(vk::MemoryPropertyFlagBits::eHostVisible | vk::MemoryPropertyFlagBits::eHostCoherent |
+                                            vk::MemoryPropertyFlagBits::eHostCached);
+        }
+    }
+    device->device.bindBufferMemory(buf->buffer, buf->device_memory, 0);
+    buf->device = device;
+    buf->size = size;
+    if (device->buffer_device_address) {
+        const vk::BufferDeviceAddressInfo addressInfo(buf->buffer);
+        buf->bda_addr = device->device.getBufferAddress(addressInfo);
+    }
+    device->memory_logger->log_allocation(buf, size);
+    return buf;
+}
