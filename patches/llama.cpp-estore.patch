+// and in-flight experts, including prefetches. Otherwise, or with FM_CACHE_ROUTE_SLOTS=n, it is simulated
+// per layer (n slots, default 9: an LRU over the layer's own history, as estore's LAYER policy keeps it),
+// walking the batch's tokens in order, so a batched evaluation sees the cache state that token-by-token
+// decode would. gamma 0 only counts misses.
+// FM_CACHE_SKIP=<tau> (with FM_CACHE_ROUTE): a chosen expert that is not cached and holds less than tau of the
+// chosen experts' router mass is replaced by the best cached expert not already chosen, and that stand-in's
+// weight is zeroed before normalisation: the token runs on the remaining experts and the flash read is skipped.
+struct fm_cache_route_layer {
+    std::vector<int> lru;   // resident experts, least recent first
+    std::vector<char> zero; // [n_tokens, n_expert] of the current batch: stand-ins whose weight is zeroed
+    long tokens = 0, misses = 0, swaps = 0, skips = 0;
+    double mass_top = 0, mass_kept = 0;   // router mass of the plain top-k vs of the chosen experts
+};
